UPDATE Developers SET availability = FALSE WHERE developer_id = 4;
SELECT "=== 2. UPDATE (Developer unavailable) ===" as Operation;
SELECT developer_id, first_name, availability FROM Developers WHERE developer_id = 4;

-- DELETE
DELETE FROM Bugs WHERE bug_id = 10;
SELECT "=== 3. DELETE (Bug removed) ===" as Operation;
SELECT COUNT(*) as remaining_bugs FROM Bugs;

-- 2. 3 JOIN QUERIES
SELECT "=== 4. JOIN QUERY 1: Project Team Overview ===" as Operation;
SELECT 
    p.project_name,
    d.first_name,
    d.role,
    pa.role_in_project
FROM Projects p
JOIN Project_Assignments pa ON p.project_id = pa.project_id
JOIN Developers d ON pa.developer_id = d.developer_id
LIMIT 10;

SELECT "=== 5. JOIN QUERY 2: Sprint Bugs Status ===" as Operation;
SELECT 
    s.sprint_name,
    p.project_name,
    COUNT(b.bug_id) as bug_count,
    AVG(CASE WHEN b.fixed_date IS NOT NULL THEN DATEDIFF(b.fixed_date, b.reported_date) END) as avg_fix_days
FROM Sprints s
JOIN Projects p ON s.project_id = p.project_id
LEFT JOIN Bugs b ON s.sprint_id = b.sprint_id
GROUP BY s.sprint_id, s.sprint_name, p.project_name
HAVING bug_count > 0;

SELECT "=== 6. JOIN QUERY 3: Test Execution Report ===" as Operation;
SELECT 
    p.project_name,
    tc.title,
    tc.status,
    d.first_name as executed_by,
    tc.executed_date
FROM Test_Cases tc
JOIN Projects p ON tc.project_id = p.project_id
LEFT JOIN Developers d ON tc.executed_by = d.developer_id
WHERE tc.status = 'Fail';

-- 3. 2 SUBQUERIES
SELECT "=== 7. SUBQUERY 1: Developers with Most Assignments ===" as Operation;
SELECT first_name, last_name,
       (SELECT COUNT(*) FROM Project_Assignments pa WHERE pa.developer_id = d.developer_id) as project_count
FROM Developers d
WHERE developer_id IN (
    SELECT developer_id FROM Project_Assignments 
    GROUP BY developer_id 
    HAVING COUNT(*) >= 2
)
ORDER BY project_count DESC;

SELECT "=== 8. SUBQUERY 2: Projects with High Bug Density ===" as Operation;
SELECT project_name, 
       (SELECT COUNT(*) FROM Bugs b WHERE b.project_id = p.project_id) as bug_count
FROM Projects p
WHERE (SELECT COUNT(*) FROM Bugs b WHERE b.project_id = p.project_id) > 
      (SELECT AVG(bug_count) FROM (SELECT COUNT(*) as bug_count FROM Bugs GROUP BY project_id) t);

-- 4. 2 AGGREGATE FUNCTIONS
SELECT "=== 9. AGGREGATE 1: Bug Dashboard (COUNT, SUM, AVG) ===" as Operation;
SELECT 
    'All Projects' as summary,
    COUNT(*) as total_bugs,
    SUM(CASE WHEN status = 'Critical' THEN 1 ELSE 0 END) as critical_bugs,
    AVG(CASE WHEN fixed_date IS NOT NULL THEN DATEDIFF(fixed_date, reported_date) END) as avg_fix_time_days
FROM Bugs;

SELECT "=== 10. AGGREGATE 2: Sprint Velocity Report (AVG, SUM) ===" as Operation;
SELECT 
    sprint_name,
    ROUND(AVG(velocity_target), 2) as avg_velocity_target,
    SUM(velocity_actual) as total_velocity_actual,
    ROUND(AVG(velocity_actual * 1.0 / NULLIF(velocity_target, 0)) * 100, 2) as avg_velocity_percentage
FROM Sprints
GROUP BY sprint_name;
