-- Create Database
CREATE DATABASE IF NOT EXISTS software_eng_db1;
USE software_eng_db1;

-- DROP existing tables if needed (for clean setup)
DROP TABLE IF EXISTS Test_Cases, Bugs, Sprints, Project_Assignments, Developers, Projects;

-- 1. Projects Table
CREATE TABLE Projects (
    project_id INT PRIMARY KEY AUTO_INCREMENT,
    project_name VARCHAR(255) NOT NULL,
    description TEXT,
    start_date DATE,
    end_date DATE,
    status ENUM('Planning', 'Active', 'Testing', 'Completed', 'On Hold', 'Cancelled') DEFAULT 'Planning',
    priority ENUM('Low', 'Medium', 'High', 'Critical') DEFAULT 'Medium',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- 2. Developers Table
CREATE TABLE Developers (
    developer_id INT PRIMARY KEY AUTO_INCREMENT,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    phone VARCHAR(20),
    role ENUM('Junior', 'Mid', 'Senior', 'Lead', 'Architect') DEFAULT 'Junior',
    skills JSON,
    availability BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 3. Project_Assignments (Many-to-Many)
CREATE TABLE Project_Assignments (
    assignment_id INT PRIMARY KEY AUTO_INCREMENT,
    project_id INT,
    developer_id INT,
    role_in_project VARCHAR(100),
    assigned_date DATE DEFAULT (CURDATE()),
    is_active BOOLEAN DEFAULT TRUE,
    FOREIGN KEY (project_id) REFERENCES Projects(project_id) ON DELETE CASCADE,
    FOREIGN KEY (developer_id) REFERENCES Developers(developer_id) ON DELETE CASCADE,
    UNIQUE KEY unique_project_dev (project_id, developer_id)
);

-- 4. Sprints Table
CREATE TABLE Sprints (
    sprint_id INT PRIMARY KEY AUTO_INCREMENT,
    project_id INT,
    sprint_name VARCHAR(100) NOT NULL,
    start_date DATE,
    end_date DATE,
    goal TEXT,
    status ENUM('Not Started', 'In Progress', 'Completed', 'Failed') DEFAULT 'Not Started',
    velocity_target INT,
    velocity_actual INT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (project_id) REFERENCES Projects(project_id) ON DELETE CASCADE
);

-- 5. Bugs Table
CREATE TABLE Bugs (
    bug_id INT PRIMARY KEY AUTO_INCREMENT,
    project_id INT,
    sprint_id INT,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    severity ENUM('Low', 'Medium', 'High', 'Critical', 'Blocker') DEFAULT 'Medium',
    priority ENUM('Low', 'Medium', 'High', 'Critical') DEFAULT 'Medium',
    status ENUM('New', 'In Progress', 'Fixed', 'Verified', 'Closed', 'Reopened') DEFAULT 'New',
    assigned_to INT NULL,
    reported_by INT NULL,
    reported_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    fixed_date TIMESTAMP NULL,
    reproduction_steps TEXT,
    expected_result TEXT,
    actual_result TEXT,
    FOREIGN KEY (project_id) REFERENCES Projects(project_id),
    FOREIGN KEY (sprint_id) REFERENCES Sprints(sprint_id),
    FOREIGN KEY (assigned_to) REFERENCES Developers(developer_id),
    FOREIGN KEY (reported_by) REFERENCES Developers(developer_id)
);

-- 6. Test_Cases Table
CREATE TABLE Test_Cases (
    test_case_id INT PRIMARY KEY AUTO_INCREMENT,
    project_id INT NOT NULL,
    sprint_id INT,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    precondition TEXT,
    steps TEXT,
    expected_result TEXT,
    actual_result TEXT,
    status ENUM('Not Executed', 'Pass', 'Fail', 'Blocked', 'Skipped') DEFAULT 'Not Executed',
    priority ENUM('Low', 'Medium', 'High', 'Critical') DEFAULT 'Medium',
    executed_by INT NULL,
    executed_date TIMESTAMP NULL,
    FOREIGN KEY (project_id) REFERENCES Projects(project_id),
    FOREIGN KEY (sprint_id) REFERENCES Sprints(sprint_id),
    FOREIGN KEY (executed_by) REFERENCES Developers(developer_id)
);

