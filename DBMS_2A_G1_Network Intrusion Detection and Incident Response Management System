SELECT 
    i.incident_id,
    d.hostname,
    a.alert_type,
    an.name AS analyst,
    i.status,
    r.action_taken
FROM incidents i
JOIN alerts a ON i.alert_id = a.alert_id
JOIN devices d ON a.device_id = d.device_id
JOIN analysts an ON i.analyst_id = an.analyst_id
JOIN response_actions r ON i.incident_id = r.incident_id;

-- incidents per analyst
SELECT an.name, COUNT(*) AS total_incidents
FROM analysts an
JOIN incidents i ON an.analyst_id = i.analyst_id
GROUP BY an.name;

-- alerts with device info
SELECT d.hostname, a.alert_type, a.severity
FROM alerts a
JOIN devices d ON a.device_id = d.device_id;

-- analysts handling high priority incidents
SELECT name
FROM analysts
WHERE analyst_id IN (
    SELECT analyst_id FROM incidents WHERE priority = 'Critical'
);

-- devices with alerts
SELECT hostname
FROM devices
WHERE device_id IN (
    SELECT device_id FROM alerts
);

-- count incidents by status
SELECT status, COUNT(*) 
FROM incidents
GROUP BY status;

-- average incidents per analyst
SELECT AVG(incident_count)
FROM (
    SELECT COUNT(*) AS incident_count
    FROM incidents
    GROUP BY analyst_id
) AS sub;

